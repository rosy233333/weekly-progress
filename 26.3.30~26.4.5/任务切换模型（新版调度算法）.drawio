                <mxCell id="12" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); color: rgb(0, 0, 0);&quot;&gt;当前任务状态&lt;/font&gt;" vertex="1">
